# Application
NODE_ENV=development
# Where projects and generated media live. Projects are written to
# <dir>/<projectId>/project.json as they change, so a restart keeps your work.
# Set STORYFORGE_PERSISTENCE=memory for a throwaway session that saves nothing.
# Render each scene's end frame with its start frame as a reference image, so
# wardrobe, styling and lighting carry across the two independent renders.
# Needs an image model that accepts reference images.
#   END_FRAME_REFERENCES_START_FRAME=false
STORYFORGE_DATA_DIR=./projects
STORYFORGE_PERSISTENCE=file
# Only used when STORYFORGE_PERSISTENCE=prisma.
DATABASE_URL=postgresql://storyforge:storyforge@localhost:5432/storyforge

# Structured media prompt composer (SPEC-003).
# Rebuilds the deterministic image/video prompts around a shared semantic
# contract: images open with shot size and camera height, video leads with the
# dominant action, and each fact is stated once. Off by default because it
# changes every prompt sent to WanGP, and the only honest way to know a prompt
# change is an improvement is to render with it. Compare the two with
# `npm run prompts:preview` before enabling.
#   MEDIA_PROMPT_COMPOSER_V2=true

# Durable task state and recovery (SPEC-008).
# Persists canvas and scene queue state to <dataDir>/<projectId>/tasks.json so a
# restart reconciles rather than losing or resubmitting work. A job interrupted
# between submission and acknowledgement becomes submission_unknown and is never
# resent automatically — generation is not idempotent, so a duplicate costs real
# GPU minutes. Off by default until live reconciliation against WanGP has been
# proven; while off, the previous in-memory queues run unchanged and the two
# drainers never both own a project.
#   DURABLE_TASKS=true

# Network boundary
# Which interface to listen on. The default serves your workstation only.
# Next binds every interface when this is unset, which includes whatever LAN you
# happen to be attached to.
STORYFORGE_BIND_HOST=127.0.0.1
# Host header values the app will answer to. Each entry is accepted with and
# without the port. This is what blocks DNS rebinding, where a hostile domain
# re-resolves to 127.0.0.1 and the browser then treats it as same-origin.
#   STORYFORGE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
#
# To reach the app from your phone over Tailscale, bind to this machine's tailnet
# address and name the hostname you will type. Note that binding to one interface
# stops localhost being served, so the desktop must use the same name:
#   STORYFORGE_BIND_HOST=100.71.40.31
#   STORYFORGE_ALLOWED_HOSTS=box.tailnet.ts.net
#
# To keep localhost working as well, bind 0.0.0.0 and let the allowlist do the
# work. Next cannot bind two specific addresses, so this is the only way to have
# both. The socket is then open on your LAN too, and a request arriving there is
# refused by the Host check rather than by the network — a weaker boundary, so
# keep a host firewall in front:
#   STORYFORGE_BIND_HOST=0.0.0.0
#   STORYFORGE_ALLOWED_HOSTS=localhost,127.0.0.1,box.tailnet.ts.net
#
# The app refuses to start if you bind wider than loopback without setting the
# allowlist.
#
# There is no login. Tailscale ACLs decide which devices may connect; these
# settings decide which requests the app will honour once they do. Exposing the
# app publicly (Tailscale Funnel, a public reverse proxy) is out of scope and
# needs real authentication first.

# Story/video defaults
DEFAULT_SEGMENT_SECONDS=20
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_FPS=24
DEFAULT_RESOLUTION=1280x720

# WanGP sidecar
# Set WANGP_MCP_ENABLED=true to use the live MCP client instead of the mock.
# Start WanGP first:
#   python wgp.py --mcp --mcp-transport streamable-http --mcp-host 127.0.0.1 --mcp-port 7866
WANGP_MCP_ENABLED=false
WANGP_MCP_URL=http://127.0.0.1:7866/mcp
# Absolute path to the WanGP outputs folder (where generated media lands).
# Generated clips are only servable if they sit inside this root.
# Default pinokio install: C:\pinokio\api\wan.git\app\outputs
WANGP_OUTPUT_DIR=
# Absolute path to the WanGP loras folder, for LoRA discovery fallback.
# The MCP server exposes no LoRA inventory tool, so this is how LoRAs are found.
WANGP_LORA_ROOT=
# LoRA Manager sidecar records (display names + trigger words). Defaults to the
# `loras_metadata` folder beside WANGP_LORA_ROOT, so this rarely needs setting.
WANGP_LORA_METADATA_ROOT=
# Append a selected LoRA's trigger words to the prompt when they are missing.
# Many LoRAs do nothing at all without their trained word, so this is on by
# default. Only absent words are added, so hand-edited prompts never duplicate.
#   LORA_APPEND_TRIGGER_WORDS=false
# Character identity conditioning.
# A reference photo is supplied to fix a likeness, but with the background intact
# the whole image acts as the reference and the signal is diluted. On by default.
#   WANGP_REMOVE_REFERENCE_BACKGROUND=false
# Upscaler applied to a clip whose resolution was held down by a model ceiling.
# Rendering small is only half of the recommendation for a heavy video model;
# without the upscale it is just a small clip. WanGP keeps this as saved UI
# state, so StoryForgeAI writes it rather than inheriting whatever was last
# clicked there. Set empty to leave it alone.
#   WANGP_VIDEO_SPATIAL_UPSAMPLING=
# Face swap runs a Qwen Image Edit pass over each generated keyframe, replacing
# the head with the one in the character's reference image. Enabled per character
# in the library; this switch disables the feature outright. The model must be a
# Qwen Image Edit variant, with both face-swap LoRAs present in loras/qwen.
#   FACE_SWAP_ENABLED=false
#   FACE_SWAP_MODEL=qwen_image_edit_plus2_20B
# Explicit model pins. Strongly recommended: WanGP exposes ~200 models with no
# quality ranking, so automatic selection cannot tell a general text-to-image
# model from an inpainting or avatar variant.
#
# Pin an image model that accepts reference images if you use the character
# library: models without `media_inputs.image.reference` silently ignore them.
# Flux 2 Klein is text-to-image and reference-capable, which covers both cases.
#   WANGP_VIDEO_MODEL=ltx2_22B_distilled_1_1
#   WANGP_IMAGE_MODEL=flux2_klein_9b
#   WANGP_AUDIO_MODEL=stable_audio3_small
WANGP_VIDEO_MODEL=
WANGP_IMAGE_MODEL=
WANGP_AUDIO_MODEL=
# Live job polling. Defaults give a 30-minute ceiling per job.
WANGP_POLL_INTERVAL_MS=3000
WANGP_MAX_POLL_ATTEMPTS=600

# AI planning agents, optional.
# Works with OpenAI, or any OpenAI-compatible local server. For LM Studio:
#   OPENAI_BASE_URL=http://127.0.0.1:1234/v1
#   OPENAI_MODEL=<the model id shown in LM Studio>
# A local server needs no real key; the SDK just requires a non-empty value.
AI_PLANNING_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Vision model, for the QC agent to grade rendered keyframes rather than prompt
# text. Leave empty and QC reviews prompts only — it will not pretend to have
# seen the images. QC is off per project by default either way.
OPENAI_VISION_MODEL=
# Planning-model control (LM Studio). On a single-GPU machine the planning LLM
# and the image/video models cannot both be resident: LM Studio holds its model
# for an hour by default, which starves WanGP and fails renders with an
# out-of-memory hint. When OPENAI_BASE_URL is set, the Storyboard screen gains
# Load/Unload buttons that drive LM Studio's `lms` CLI. Set to false to hide
# them, or point at the CLI if it is not on PATH.
#   LLM_RUNTIME_CONTROL_ENABLED=false
#   LMSTUDIO_CLI_PATH=C:\Users\you\.lmstudio\bin\lms.exe
# A batch run unloads the planning model first, because a local LLM and the
# image/video models cannot share one consumer GPU — overlapping them produces
# CUDA faults partway through rather than a clean refusal. Set to false to keep
# the model resident and manage it yourself.
#   LLM_UNLOAD_BEFORE_BATCH=false
# Batch generation pacing. Transient GPU faults (CUDA errors, out of memory)
# are retried; the settle delay lets WanGP release VRAM between scenes.
#   SCENE_QUEUE_RETRY_ATTEMPTS=1
#   SCENE_QUEUE_RETRY_DELAY_MS=20000
#   SCENE_QUEUE_SETTLE_DELAY_MS=5000
OPENAI_TEMPERATURE=0.7
# Hard caps. Reasoning models (Qwen3, DeepSeek-R1, etc.) spend this budget on
# thinking before emitting any content, so too low a cap truncates the answer
# mid-object rather than shortening it. Watch for agent.llm.failed with
# reason=unparseable_json / empty_response and finishReason=length.
#
# Two ceilings apply, and the lower one wins:
#   1. `prompt + max_tokens` must fit the server's LOADED context window, which
#      for a local server is often far below the model's maximum.
#   2. max_tokens must be reachable within OPENAI_TIMEOUT_MS at the model's
#      throughput, or the request times out before the cap is ever hit.
# Run `npm run llm:context` to measure real headroom and get a safe ceiling.
OPENAI_MAX_TOKENS=12000
OPENAI_TIMEOUT_MS=240000
# auto | json_schema | json_object | text. "auto" tries json_schema first,
# which constrains generation to the artifact's exact shape — the only reliable
# way to get a small local model to return conforming JSON. Steps down
# automatically if the server refuses a format.
OPENAI_RESPONSE_FORMAT=auto

# Feature flags
DEEPY_ASSIST_ENABLED=false
ANIMATIC_ASSEMBLY_ENABLED=false
PLATFORM_DERIVATIVES_ENABLED=false

# ffmpeg assembly
# Set FFMPEG_ENABLED=true to write real rough cuts instead of recording the
# command. Requires ffmpeg + ffprobe on PATH (or set the paths below).
FFMPEG_ENABLED=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=medium
FFMPEG_CRF=20
FFMPEG_TIMEOUT_MS=900000
# LTX-2 clips carry an aac 48kHz stereo track; assembly preserves it.
FFMPEG_AUDIO_CODEC=aac
FFMPEG_AUDIO_BITRATE=192k
FFMPEG_AUDIO_SAMPLE_RATE=48000
FFMPEG_AUDIO_CHANNEL_LAYOUT=stereo
