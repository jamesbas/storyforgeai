// Prisma schema — durable persistence path (generic-build-spec Data Persistence
// Layer). The MVP runs on the in-memory repository in demo mode; this schema
// scaffolds the Postgres-backed store selected when STORYFORGE_PERSISTENCE=prisma.
// Enum-like fields are modeled as String, constrained by union types in
// lib/types.ts (single source of truth), not native DB enums, for portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                       String   @id
  title                    String
  concept                  String
  requestedDurationSeconds Int
  segmentSeconds           Int      @default(20)
  segmentCount             Int
  generatedDurationSeconds Int
  finalTrimSeconds         Int
  aspectRatio              String
  resolutionPreset         String
  style                    String
  tone                     String
  audience                 String?
  creativeMode             String
  narrationRequired        Boolean  @default(false)
  dialogueRequired         Boolean  @default(false)
  musicRequired            Boolean  @default(false)
  sfxRequired              Boolean  @default(false)
  generationMode           String
  modelStrategy            String
  imageModel               String?
  videoModel               String?
  // Character library opt-in. Ids reference Character.id; stored as a scalar
  // list rather than a relation so deleting a character cannot cascade into
  // rewriting historical projects.
  useCharacterLibrary      Boolean  @default(false)
  characterIds             String[] @default([])
  status                   String   @default("draft")
  // Full storyboard snapshot (brief, visual bible, scenes) stored as JSON while
  // the schema firms up (generic-build-spec Section 10.2).
  storyboard               Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Reusable character definitions shared by every project (the "cast library").
/// Global by design: the same subject description is meant to be pinned across
/// unrelated stories so a recurring face stays consistent.
model Character {
  id             String   @id
  name           String
  /// Prompt-ready physical description interpolated verbatim into image and
  /// video prompts.
  description    String
  /// Traits to suppress, appended to the negative prompt.
  negativePrompt String?
  /// Filename of the stored reference image, relative to the library directory.
  referenceImage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
